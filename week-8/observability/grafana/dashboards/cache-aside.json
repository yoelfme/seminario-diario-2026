      "type": "stat",
      "targets": [
        {
          "expr": "sum(cache_requests_total{result=\"hit\"})",
          "legendFormat": "hits",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
